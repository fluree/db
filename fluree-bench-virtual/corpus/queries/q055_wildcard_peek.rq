# q055 wildcard_peek
# Intent: The canonical first query on any dataset — "show me a few triples".
# BI lineage (BI-explore-1): "Let me see what's in here." (unconstrained ?s ?p ?o)
# Exploration family: variable subject/predicate/object, LIMIT-bounded peek. No
# constraints to prune the TriplesMap fan-out.
SELECT ?s ?p ?o
WHERE { ?s ?p ?o }
LIMIT 5
